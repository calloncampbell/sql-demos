<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build">
  <Sdk Name="Microsoft.Build.Sql" Version="2.3.0" />
  <PropertyGroup>
    <Name>StarTrek.Database</Name>
    <DSP>Microsoft.Data.Tools.Schema.Sql.SqlAzureV12DatabaseSchemaProvider</DSP>
    <ModelCollation>1033, CI</ModelCollation>
    <DefaultCollation>SQL_Latin1_General_CP1_CI_AS</DefaultCollation>
    <TreatTSqlWarningsAsErrors>True</TreatTSqlWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Build Remove="Scripts\**" />
    <PostDeploy Include="Scripts\PostDeployment\Script.PostDeployment.sql" />
    <None Include="Scripts\PostDeployment\Seed.*.sql" />
    <None Include="Scripts\Demo\*.sql" />
  </ItemGroup>
</Project>
